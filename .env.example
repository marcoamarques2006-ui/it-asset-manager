# Copie para .env e preencha. O .env real nunca é commitado (.gitignore).
# Nenhuma senha fica no repositório: em dev você escolhe a sua; no CI ela é
# gerada aleatoriamente a cada execução; em homologação/produção vem dos
# secrets de cada environment do GitHub (ver docs/devops.md).
POSTGRES_USER=itam
POSTGRES_PASSWORD=
POSTGRES_DB=itam

APP_ENV=development
APP_DEBUG=true
SECRET_KEY=
